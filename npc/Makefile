TOPNAME = top
NPC_HOME = $(abspath .)
NEMU_HOME = $(abspath ../nemu)
AM_HOME = $(abspath ../am-kernels)


TEST_NAME ?= dummy


IMAGE_FILE = $(AM_HOME)/tests/cpu-tests/build/$(TEST_NAME)-riscv32e-npc.bin
ELF_FILE   = $(AM_HOME)/tests/cpu-tests/build/$(TEST_NAME)-riscv32e-npc.elf
DIFF_REF_SO = $(NEMU_HOME)/build/riscv32-nemu-interpreter-so


NPC_KCONFIG = $(NPC_HOME)/Kconfig
NPC_CONFIG  = $(NPC_HOME)/.config
AUTOCONF_H := $(NPC_HOME)/config/autoconf.h

MCONF  := $(NEMU_HOME)/tools/kconfig/build/mconf
CONF   := $(NEMU_HOME)/tools/kconfig/build/conf
K_GEN  := $(NEMU_HOME)/scripts/kconfig_gen.py


VERILATOR = verilator
VERILATOR_CFLAGS += -MMD --build -cc  \
				-O3 --x-assign fast --x-initial fast --noassert \
				-I$(NPC_HOME)/build/config

BUILD_DIR = ./build
OBJ_DIR = $(BUILD_DIR)/obj_dir
BIN = $(BUILD_DIR)/$(TOPNAME)


VSRCS = $(shell find ./vsrc -name "*.v")
CSRCS = $(shell find ./csrc -name "*.cpp")
LDFLAGS += -lreadline -ldl

default: $(BIN)

$(BIN): $(VSRCS) $(CSRCS) $(AUTOCONF_H)
	@mkdir -p $(BUILD_DIR)
	$(VERILATOR) $(VERILATOR_CFLAGS) \
		--top-module $(TOPNAME) \
		--exe \
		-o $(abspath $@) \
		-LDFLAGS "$(LDFLAGS)" \
		$(VSRCS) $(CSRCS)


$(AUTOCONF_H): $(NPC_CONFIG)
	@mkdir -p $(dir $@)
	@echo "  GEN     $@"
	@echo "/* Generated by Makefile - DO NOT EDIT */" > $@
	@echo "#ifndef __AUTOCONF_H__" >> $@
	@echo "#define __AUTOCONF_H__" >> $@
	@# 1. 过滤掉注释行 2. 把 CONFIG_XXX=y 换成 #define CONFIG_XXX 1
	@grep "^CONFIG_" $< | sed 's/=y/ 1/' | sed 's/^/#define /' >> $@
	@echo "#endif" >> $@

menuconfig:
	@mkdir -p $(dir $(AUTOCONF_H))
	$(MCONF) $(NPC_KCONFIG)
	$(CONF) --syncconfig $(NPC_KCONFIG)
	@# 重新运行上面的生成逻辑
	@$(MAKE) $(AUTOCONF_H)

run: $(BIN)
	$(BIN) $(IMAGE_FILE) $(DIFF_REF_SO) $(ELF_FILE)
clean:
	rm -rf $(BUILD_DIR)

include ../Makefile


